NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Use your PostgreSQL connection strings. The example values match docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverx?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/recoverx?schema=public

# Replace placeholders before starting the backend.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
ADMIN_LOGIN_USERNAME=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Google Drive: point this at a folder ID or its URL.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# For a Shared Drive, use a service account with Content manager access:
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json

# For a personal Google Drive, use OAuth instead of a service account:
# GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# Local development API. In production, use the same-origin /api rewrite.
VITE_API_BASE_URL=http://localhost:4000/api

# Firebase Authentication client config (public web-app settings, not server secrets).
# Enable Google and Phone providers in the Firebase Console before using these methods.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
